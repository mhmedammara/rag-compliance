# Copiez ce fichier en .env (meme dossier) avant "docker compose up -d".
# Les memes valeurs servent a la credential Postgres de n8n
# (Host : postgres, Port : 5432, SSL : disable) ; scripts/deploy_base.py les
# lit directement ici (port 5433 cote hote).
POSTGRES_USER=logiclever
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=logiclever
