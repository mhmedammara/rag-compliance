# =====================================================================
#  Copiez ce fichier en .env et renseignez les valeurs.
#  Ces variables ne servent qu'au chargement de la base (scripts Python).
#  Dans n8n, les memes acces sont configures en tant que Credentials.
# =====================================================================

# Supabase > Project Settings > Database > Connection string > URI
# Prendre la chaine "Session pooler" (port 5432) et remplacer [YOUR-PASSWORD].
SUPABASE_DB_URL
# Embeddings uniquement. Anthropic n'expose pas d'API d'embeddings :
# la generation de texte utilise Claude, la vectorisation utilise OpenAI.
OPENAI_API_KEY=sk-...

# Optionnel : modele d'embedding. Doit rester coherent avec vector(1536)
# dans sql/01_schema.sql et avec le noeud "Parametres" du workflow n8n.
EMBEDDING_MODEL=text-embedding-3-large

# Televersement des PDF de preuve vers Supabase Storage (bucket public
# "documents-preuve"), pour renseigner documents.url_partage.
# Supabase > Project Settings > API > Project API keys > service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Optionnel : deduit automatiquement de SUPABASE_DB_URL si absent.
SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# ---------------------------------------------------------------------
# A renseigner cote n8n (Credentials), pas ici :
#   - Supabase API : https://VOTRE-PROJET.supabase.co + cle service_role
#   - Anthropic    : cle API (modele claude-opus-5)
#   - OpenAI       : meme cle que ci-dessus
# ---------------------------------------------------------------------
