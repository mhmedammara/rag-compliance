# =====================================================================
#  Variables lues par scripts/deploy_base.py dans l'environnement de la
#  session (PowerShell : $env:OPENAI_API_KEY = "sk-..."). Seule
#  OPENAI_API_KEY est obligatoire.
#  Dans n8n, les memes acces sont configures en tant que Credentials.
# =====================================================================

# Optionnel. Par defaut, la connexion est construite depuis docker/.env
# (conteneur "postgres", port 5433 cote hote). A renseigner seulement pour
# viser une autre base ; une valeur restee a l'exemple est ignoree.
# DATABASE_URL=postgresql://logiclever:MOTDEPASSE@127.0.0.1:5433/logiclever

# Cote scripts, sert uniquement aux embeddings (vectorisation du corpus). Le
# workflow n8n utilise la meme cle, via sa credential OpenAI, pour les
# embeddings et pour les modeles de redaction/controle.
OPENAI_API_KEY=sk-...

# Optionnel : modele d'embedding. Doit rester coherent avec vector(1536)
# dans sql/01_schema.sql et avec le noeud "Parametres" du workflow n8n.
EMBEDDING_MODEL=text-embedding-3-large

# Optionnel : copie des fichiers de preuve, servis par le conteneur
# "fichiers" (nginx) pour renseigner documents.url_partage.
# STOCKAGE_DIR=C:\...\compliance-rag\docker\stockage   (defaut)
FICHIERS_URL=http://localhost:8088

# ---------------------------------------------------------------------
# A renseigner cote n8n (Credentials), pas ici :
#   - Postgres  : Host postgres, Port 5432, Database/User/Password de
#                 docker/.env, SSL disable
#   - OpenAI    : meme cle que ci-dessus
# ---------------------------------------------------------------------
